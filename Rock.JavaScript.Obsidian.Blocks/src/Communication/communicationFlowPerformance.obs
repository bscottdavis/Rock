        },
        {
            value: 0.15,
            label: "2024-09-16T00:00:00.000Z",
            seriesName: "Conversion Rate",
            color: "#68D391",
        }
    ];

    class LineChartHelper {
        private constructor(private dataPoints: ChartNumericDataPointBag[]) { }

        public static fromDataPoints(dataPoints: ChartNumericDataPointBag[]): LineChartHelper {
            return new LineChartHelper(dataPoints);
        }

        public convertLabelsToLocaleDateLabels(): LineChartHelper {
            return new LineChartHelper(this.dataPoints.map(d => {
                const parsedDate = RockDateTime.parseISO(d.label!);
                if (parsedDate) {
                    d.label = parsedDate.toLocaleShortDateString();
                }
                return d;
            }));
        }

        public getChartData(): ChartData<"line"> {
            const labels = [...new Set(this.dataPoints.map(d => d.label!))];
            const seriesNames = [...new Set(this.dataPoints.map(d => d.seriesName!))];
            return {
                labels,
                datasets: seriesNames.map(seriesName => {
                    const colors = this.dataPoints.filter(d => d.seriesName === seriesName).map(d => d.color!);
                    return {
                        label: seriesName,
                        data: this.dataPoints.filter(d => d.seriesName === seriesName).map(d => d.value),
                        backgroundColor: colors,
                        borderColor: colors,
                    };
                })
            };
        }
    }

    class BarChartHelper {
        private constructor(private dataPoints: ChartNumericDataPointBag[]) { }

        public static fromDataPoints(dataPoints: ChartNumericDataPointBag[]): BarChartHelper {
            return new BarChartHelper(dataPoints);
        }

        public getChartData(): ChartData<"bar"> {
            const labels = [...new Set(this.dataPoints.map(d => d.seriesName!))];
            return {
                labels,
                datasets: [...new Set<string>(this.dataPoints.map(d => d.label!))].map(label => (
                    {
                        label,
                        data: this.dataPoints.filter(d => d.label === label).map(d => d.value),
                        backgroundColor: this.dataPoints.filter(d => d.label === label).map(d => d.color!),
                        borderColor: this.dataPoints.filter(d => d.label === label).map(d => d.color!),
                        grouped: true
                    }))
            };
        }
    }

    const totalFlowPerformanceOverTimeData: ChartData<"line"> = LineChartHelper
        .fromDataPoints(totalFlowPerformanceOverTimeDataPoints)
        .convertLabelsToLocaleDateLabels()
        .getChartData();

    const totalFlowPerformanceOverTimeOptions: ChartOptions<"line"> = {
        scales: {
            y: {
                ticks: {
                    callback(tickValue, index, ticks) {
                        // Format the tick value as a percentage
                        return `${(Number(tickValue) * 100).toFixed(0)}%`;
                    },
                }
            }
        }
    };

    const instanceVsFlowPerformanceAverageDataPoints: ChartNumericDataPointBag[] = [
        {
            value: 0.11,
            label: "Instance",
            seriesName: "Conversion Rate",
            color: "#38A169",
        },
        {
            value: 0.09,
            label: "Average",
            seriesName: "Conversion Rate",
            color: "#CDEAE1",
        },
        {
            value: 0.01,
            label: "Instance",
            seriesName: "Unsubscribe Rate",
            color: "#E53E3E",
        },
        {
            value: 0.02,
            label: "Average",
            seriesName: "Unsubscribe Rate",
            color: "#FAD8D8",
        },
    ];

    const instanceVsFlowPerformanceAverageData: ChartData<"bar"> = BarChartHelper
        .fromDataPoints(instanceVsFlowPerformanceAverageDataPoints)
        .getChartData();

    const topLine = {
        id: "topLine",
        afterDatasetDraw(chart: Chart<"bar">, { index: datasetIndex, meta }: { index: number; meta: ChartMeta<"bar"> }) {
            const { ctx, data } = chart;

            ctx.save();
            chart.getDatasetMeta(datasetIndex).data.forEach((datapoint, datapointIndex) => {
                // text
                ctx.font = "normal 14px sans-serif";
                ctx.fillStyle = getCssValue("--color-interface-medium");
                ctx.textAlign = "center";
                const label = data.datasets[datasetIndex].label;
                ctx.fillText(typeof label === "string" ? label : "", datapoint.x, datapoint.y - 7);
            });
        }
    };

    const instanceVsFlowPerformanceAverageOptions: ChartOptions<"bar"> = {
        scales: {
            y: {
                ticks: {
                    callback(tickValue, index, ticks) {
                        // Format the tick value as a percentage
                        return `${(Number(tickValue) * 100).toFixed(0)}%`;
                    },
                }
            }
        },
        plugins: {
            legend: {
                display: false
            },
            title: {
                text: "hello there"
            }
        }
    };

    // #region Functions

    function getCssValue(variableName: string): string {
        return getComputedStyle(document.documentElement).getPropertyValue(variableName).trim();
    }

    // #endregion Functions
</script>
