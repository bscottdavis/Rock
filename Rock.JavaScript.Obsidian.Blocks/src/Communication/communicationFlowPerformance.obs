                    <ChartControl type="bar" :data="instanceVsFlowPerformanceAverageData" :options="instanceVsFlowPerformanceAverageOptions" :plugins="[topLine]" />
                </Panel>
            </div>
        </div>

        <Grid />
    </Panel>
</template>

