<template>
    <DropDownContent class="communication-time-trigger-button"
                     :disabled="disabled"
                     preventOverflowClipping
                     showArrow>
        <template #anchor>
            <RockButton btnSize="xs" :disabled="disabled">
                <template v-if="internalDaysToWait">
                    <i class="fa fa-clock"></i> <span class="text-muted">Wait</span> <strong>{{ internalDaysToWait }}</strong> {{ internalDaysToWait === 1 ? 'Day' : 'Days' }}, <span class="text-muted">Send at</span> <strong>{{ timeToSendAsString }}</strong> <i class="fa fa-chevron-down"></i>
                </template>

                <template v-else>
                    <i class="fa fa-bolt"></i> <span class="text-muted">Start</span> <strong>Immediately</strong>, <span class="text-muted">Send at</span> <strong>{{ timeToSendAsString }}</strong> <i class="fa fa-chevron-down"></i>
                </template>
            </RockButton>
        </template>

        <div class="communication-time-trigger-content">
            <RockLabel>Wait</RockLabel>
            <NumberBox v-model="nonNullableDaysToWait"
                       :disabled="disabled"
                       :minimumValue="0">
                <template #inputGroupAppend>
                    <span class="input-group-addon">Day(s)</span>
                </template>
            </NumberBox>

            <RockLabel>Send At</RockLabel>
            <TimePicker v-model="timeToSendAsPickerValue" :disabled="disabled" />
        </div>
    </DropDownContent>
</template>

<style scoped>
.communication-time-trigger-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: var(--spacing-large);
    gap: var(--spacing-large);
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import DropDownContent from "@Obsidian/Controls/dropDownContent.obs";
    import NumberBox from "@Obsidian/Controls/numberBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import RockLabel from "@Obsidian/Controls/rockLabel.obs";
    import TimePicker from "@Obsidian/Controls/timePicker.obs";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { TimePickerValue } from "@Obsidian/ViewModels/Controls/timePickerValue";
    import { toNumber } from "@Obsidian/Utility/numberUtils";

    const props = defineProps({
        daysToWait: {
            type: Number as PropType<number>,
            required: true
        },

        disabled: {
            type: Boolean as PropType<boolean>,
            required: true
        },

        timeToSend: {
            type: String as PropType<string>,
            required: true
        },
    });

    const emit = defineEmits<{
        (e: "update:daysToWait", value: number): void;
        (e: "update:timeToSend", value: string): void;
    }>();

    // #region Values

    const internalDaysToWait = useVModelPassthrough(props, "daysToWait", emit);
    const internalTimeToSend = useVModelPassthrough(props, "timeToSend", emit);

    // #endregion Values

    // #region Computed Values

    const timeToSendAsPickerValue = computed<TimePickerValue>({
        get() {
            const values = /^(\d+):(\d+)/.exec(internalTimeToSend.value);

            if (values !== null) {
                return {
                    hour: toNumber(values[1]),
                    minute: toNumber(values[2])
                };
            }
            else {
                return {};
            }
        },
        set(value: TimePickerValue) {
            internalTimeToSend.value = `${value.hour}:${value.minute}:00`;
        }
    });

    const timeToSendAsString = computed<string>(() => {
        const values = /^(\d+):(\d+)/.exec(internalTimeToSend.value);

        if (values !== null) {
            const hour = toNumber(values[1]);
            const minute = toNumber(values[2]);

            return `${hour}:${minute > 9 ? `${minute}` : `0${minute}`}${hour >= 12 ? "PM" : "AM"}`;
        }
        else {
            return "";
        }
    });

    const nonNullableDaysToWait = computed<number | null>({
        get() {
            return internalDaysToWait.value ?? 0;
        },
        set(value: number | null) {
            internalDaysToWait.value = value ?? 0;
        }
    });

    // #endregion Computed Values
</script>