<template>
    <Panel panelBodyCssClass="chart-container"
           title="Total Flow Performance Over Time">
        <ChartControl :data="totalFlowPerformanceOverTimeData"
                      :options="totalFlowPerformanceOverTimeOptions"
                      type="line" />
    </Panel>
</template>

<style scoped>
:deep(.chart-container) {
    height: 265px;
}
</style>

<script setup lang="ts">
    import { computed, PropType } from "vue";
    import { LineChartDataBuilder, LineChartOptionsBuilder } from "./types.partial";
    import ChartControl from "@Obsidian/Controls/chart.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import { ChartData, ChartOptions } from "@Obsidian/Libs/chart";
    import { ChartNumericDataPointBag } from "@Obsidian/ViewModels/Reporting/chartNumericDataPointBag";

    const props = defineProps({
        dataPoints: {
            type: Array as PropType<ChartNumericDataPointBag[]>,
            required: true
        }
    });

    const totalFlowPerformanceOverTimeData = computed<ChartData<"line">>(() => {
        return LineChartDataBuilder
            .createFromData(props.dataPoints)
            .withISODateLabelsAsLocaleShortDates()
            .withDecimalValuesConvertedToPercentages()
            .build();
    });

    const totalFlowPerformanceOverTimeOptions = computed<ChartOptions<"line">>(() => {
        return LineChartOptionsBuilder
            .create()
            .withValueFormattedAsPercentage()
            .withResponsiveSizing()
            .build();
    });
</script>